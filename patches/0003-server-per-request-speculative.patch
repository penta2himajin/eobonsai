--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -1747,6 +1747,13 @@ private:
         // the per-request limit takes priority over the global one
         slot.n_predict_max = task.params.n_predict != -1 ? task.params.n_predict : params_base.n_predict;
 
+        // the speculative method is fixed when the context is built; a request can only turn it
+        // off, and only for its own generation
+        const auto & spec_types = task.params.speculative.types;
+        const bool spec_off = spec_types.size() == 1 && spec_types[0] == COMMON_SPECULATIVE_TYPE_NONE;
+        slot.spec = (spec && !spec_off) ? spec.get() : nullptr;
+        slot.stats.speculative = slot.can_speculate();
+
         slot.task = std::make_unique<const server_task>(std::move(task));
 
         slot.state = slot.task->is_child()
