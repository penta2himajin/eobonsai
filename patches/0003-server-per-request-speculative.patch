         // the per-request limit takes priority over the global one
         slot.n_predict_max = task.params.n_predict != -1 ? task.params.n_predict : params_base.n_predict;
 
+        // the speculative method is fixed when the context is built; a request can only turn it
+        // off, and only for its own generation
+        const auto & spec_types = task.params.speculative.types;
+        const bool spec_off = spec_types.size() == 1 && spec_types[0] == COMMON_SPECULATIVE_TYPE_NONE;
+        slot.spec = (spec && !spec_off) ? spec.get() : nullptr;
+        slot.spec_auto            = slot.spec ? task.params.speculative_auto : false;
+        slot.spec_auto_accept_min = task.params.speculative_auto_accept_min;
+        slot.spec_auto_min_draft  = task.params.speculative_auto_min_draft;
+        slot.stats.speculative = slot.can_speculate();
+
         slot.task = std::make_unique<const server_task>(std::move(task));
 
         slot.state = slot.task->is_child()
@@ -2912,6 +2927,22 @@ private:
             if (spec) {
                 common_speculative_get_draft_params(spec.get(), slot.id).drafting = false;
 
+                // "auto": stop drafting for the rest of this generation once too many drafts have
+                // been rejected. Only latch at a step with no draft pending, so that the tokens
+                // already in the batch are always consumed by the accept path below.
+                if (slot.spec_auto && slot.spec_draft.empty() && slot.spec_i_batch.empty()) {
+                    const uint64_t n_draft = slot.stats.n_draft_tokens;
+                    const uint64_t n_acc   = slot.stats.n_draft_accepted;
+
+                    if (n_draft >= (uint64_t) slot.spec_auto_min_draft &&
+                            (double) n_acc < (double) slot.spec_auto_accept_min * (double) n_draft) {
+                        SLT_INF(slot, "speculative auto: stopping, %" PRIu64 " of %" PRIu64
+                                " drafted tokens accepted\n", n_acc, n_draft);
+                        slot.spec      = nullptr;
+                        slot.spec_auto = false;
+                    }
+                }
+
                 const bool use_ckpt_tgt = ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
                 const bool use_ckpt_dft = ctx_dft_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
 
