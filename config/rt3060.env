# Launch profile for Bonsai 2 27B on the RTX 3060 12 GB, single user.
#
# Every value uses the ": ${VAR:=default}" form, so anything already set in the
# environment wins. A single run can therefore override any setting:
#
#   CTX=65536 scripts/serve.sh
#
# Values marked (measured) come from a file under results/.
#
# ---------------------------------------------------------------------------
# model
# ---------------------------------------------------------------------------
# PQ2_0 is settled by measurement, not by the model card: on this card PTQ1_0's
# prefill is 4% faster but its decode is 31% slower (22.51 vs 29.55 t/s), because
# dense-trit unpacking leaves it at 45% of the achievable bandwidth against 71%.
# See docs/decisions/0001-packing-choice.md.
: "${PACK:=PQ2_0}"

# ---------------------------------------------------------------------------
# execution
# ---------------------------------------------------------------------------
: "${NGL:=99}"            # offload every layer; the model is 7.19 GiB in PQ2_0
: "${FA:=on}"             # required for the model's attention path
: "${THREADS:=8}"
# -b/-ub were swept 512..4096 and everything landed within 1.5% (pp512 487-494),
# so the defaults stand. Prefill is at the dp4a ceiling, not batch-shape limited.
: "${UB:=512}"
: "${BATCH:=2048}"

# ---------------------------------------------------------------------------
# context and KV
# ---------------------------------------------------------------------------
# Depth costs bandwidth: 16 full-attention layers x 4 KV heads x 256 x 2 x 2 B =
# 64 KiB/token, measured to within 8% of prediction. Decode: 29.55 t/s at depth 0,
# 28.04 at 8K, 24.09 at 32K.
#
# Measured 12 GB budget (llama.cpp sees 11904 MiB with the display attached):
#   weights  6872 MiB (fixed)
#   buffers   736 MiB at ctx 32768, 764 MiB at 65536
#   KV        64 MiB per 1024 tokens (f16)
# Observed totals: 9656 MiB at ctx 32768, 11732 MiB at ctx 65536, both of which
# load. That leaves room for about 74K tokens at f16.
#
# 32K is the working default. 64K is verified to fit. Above that, measure first.
: "${CTX:=32768}"
# f16 measured fastest at every depth; quantized KV is slower, not faster, on this
# backend (19.40 vs 24.09 t/s at 32K). See docs/decisions/0002-kv-cache-precision.md.
: "${KV_TYPE:=f16}"

# ---------------------------------------------------------------------------
# serving
# ---------------------------------------------------------------------------
: "${HOST:=127.0.0.1}"    # loopback only; a non-loopback bind exposes an unauthenticated API
: "${PORT:=8080}"
: "${NP:=1}"              # one slot: a 12 GB card cannot hold several long contexts at once

# ---------------------------------------------------------------------------
# vision
# ---------------------------------------------------------------------------
# The 0.63 GB projector is optional. Keeping it in system RAM frees VRAM for KV at
# the cost of a slower image encode.
: "${MMPROJ:=0}"
: "${MMPROJ_CPU:=0}"

# ---------------------------------------------------------------------------
# speculative decoding
# ---------------------------------------------------------------------------
# Draft-model-free n-gram speculation. It is a large win when the output reuses the
# context and completely inert when it does not, with no regression either way:
#   code edit, thinking off   : 28.56 -> 139.88 t/s (CLI, 4.90x, 100% acceptance)
#   verbatim copy, thinking off: 28.58 -> 171.56 t/s (CLI, 6.00x)
#   code edit, thinking ON    : 28.45 -> 28.43 t/s (no drafts at all)
#   plain chat, no overlap    : 28.57 -> 28.49 t/s (no drafts at all)
# Serving path, same code-edit prompt: 28.46 -> 146.02 t/s with 85% acceptance.
#
# THE TRAP: thinking must be OFF or nothing fires. The thinking trace does not quote
# the context, so there is nothing for the matcher to draft from. And the way to turn
# it off is reasoning_effort=none per request:
#   - thinking_budget_tokens: 0 does NOT disable it (measured: still 970 chars of
#     reasoning, zero drafts)
#   - reasoning_effort "low" still thinks (25% acceptance, no net gain)
#   - reasoning_effort "minimal" is rejected with HTTP 500
# Turn it on per request, not server-wide: it is a quality trade.
# See docs/decisions/0003-ngram-speculation.md.
: "${SPEC_TYPE:=ngram-simple}"

# n-gram lookup and draft lengths, swept on this model (scripts/ngram-tune.sh,
# results/ngram-tune-20260928-003345.txt). The fork's defaults are 12 and 48.
# Longer drafts win because each accepted draft buys more tokens per weight pass:
#   full-file rewrite : 28.6 -> 138.5 (defaults) -> 194.3 t/s (6/128), +40% over defaults
#   explain + quote   : 28.3 ->  42.7            ->  44.1 t/s, +3% over defaults
#   plain chat        : 28.43 -> 28.3            ->  28.3 t/s, about -0.5%
# The no-op cost is real but small: the matcher runs and finds nothing. ngram-map-k is
# equal on the gain (224.1 vs 223.9 t/s) but costs more when idle (-1.4%), so the default
# stays ngram-simple.
# Greedy output is unchanged by the tuned values (verified against --spec-type none).
: "${SPEC_NGRAM_SIZE_N:=6}"
: "${SPEC_NGRAM_SIZE_M:=128}"

# ---------------------------------------------------------------------------
# generation defaults
# ---------------------------------------------------------------------------
# This is a thinking model and xhigh is the default, which is minutes of latency at
# ~29 tok/s. medium is documented as about as accurate at moderate output limits.
#
# The server default stays on thinking on purpose. Agentic or mechanical work (reading
# and rewriting files) should send reasoning_effort:"none" in the request body, which
# keeps quality where it matters and takes decode from 28 to ~146 t/s where it does not.
: "${REASONING_EFFORT:=medium}"
: "${REASONING_BUDGET:=2048}"
