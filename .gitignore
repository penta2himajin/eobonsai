# Downloaded or generated artifacts. Everything here is reproducible from the
# committed scripts, so none of it belongs in the repository.

# Pinned CUDA binary and the GGUF packs (13 GB); scripts/setup.sh re-fetches them.
bin/
models/
.venv/

# Kernel work tree and build outputs; scripts/build.sh recreates both.
third_party/
build/
out/

# Nothing under results/ is ignored on purpose: those logs and CSVs are the
# evidence trail that every number in docs/ cites. Do not add a blanket *.log
# rule here, it would silently drop them.
